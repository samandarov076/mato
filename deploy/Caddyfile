# mato-savdo — Caddy: HTTPS (Let's Encrypt avtomatik), statik frontend, /api proxy.
# Sayt manzili .env.prod dagi SITE_ADDRESS (lokal mashqda mato.localhost — Caddy o'z ichki CA bilan sertifikat beradi).
# Xavfsizlik sarlavhalari va CSP — docs/07-ishga-tushirish.md, 6.3.

{
	# Boshqaruv API faqat konteyner ichida (healthcheck shunga qaraydi)
	admin localhost:2019
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		# Inline skript yo'q (index.html dagi mavzu skripti public/theme.js da); inline uslub — React/Three.js uchun
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# Rasm yuklash chegarasi 8 MB (backend) — bir oz ortig'i bilan
	request_body {
		max_size 10MB
	}

	# Real vaqt (SSE): buferlanmaydi — "yangi xabar" signali darhol brauzerga yetadi
	handle /api/notifications/stream {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	# Frontend (SPA): nomi xeshlangan fayllar abadiy keshlanadi, kirish nuqtalari — har safar tekshiriladi
	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@fresh path / /index.html /sw.js /manifest.webmanifest /theme.js /registerSW.js
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
