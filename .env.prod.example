# mato-savdo — ishlab chiqarish sozlamalari. Nusxa oling: cp .env.prod.example .env.prod && chmod 600 .env.prod
# Bu fayl git'ga TUSHMAYDI (.gitignore). Nusxasini parol menejerida saqlang (docs/07-ishga-tushirish.md, 5-bo'lim).
# Sirlarni yaratish:  openssl rand -base64 48   (SECRET_KEY va CREDENTIALS_KEY — ikki xil!)
#                     openssl rand -base64 24   (baza parollari — uchta alohida)

# --- Sayt ---
# Domen (DNS A yozuvi serverga qaratilgan). Lokal mashqda: mato.localhost
SITE_ADDRESS=SIZNING-DOMEN.uz
HTTP_PORT=80
HTTPS_PORT=443
# Brauzerga ruxsat etilgan manzil — faqat prod domen
CORS_ORIGINS=https://SIZNING-DOMEN.uz

# --- Muhit ---
# prod: cookie faqat HTTPS; CREDENTIALS_KEY va alohida tizim roli majburiy
APP_ENV=prod
APP_TIMEZONE=Asia/Tashkent
TZ=Asia/Tashkent
# uvicorn ishchilari: 2 vCPU → 2, 4 vCPU → 4
UVICORN_WORKERS=2
# Backend faqat Caddy'dan so'rov oladi (porti tashqariga ochiq emas) — X-Forwarded-For ga ishonadi
FORWARDED_ALLOW_IPS=*

# --- Baza (PostgreSQL konteyneri) ---
POSTGRES_USER=mato
POSTGRES_PASSWORD=O-ZGARTIRING-baza-superuser-paroli
POSTGRES_DB=mato_savdo
# Uch rol, uch parol:
#  - mato        — jadvallar egasi (superuser): faqat migratsiya (deploy.sh) va zaxira
#  - mato_app    — ilova roli, RLS ta'sir qiladi (1-migratsiya shu paroldan yaratadi)
#  - mato_system — tizim roli: RLS'dan tashqari, lekin DDL va DELETE yo'q (15-migratsiya yaratadi)
DATABASE_OWNER_URL=postgresql+asyncpg://mato:O-ZGARTIRING-baza-superuser-paroli@db:5432/mato_savdo
DATABASE_URL=postgresql+asyncpg://mato_app:O-ZGARTIRING-app-paroli@db:5432/mato_savdo
DATABASE_SYSTEM_URL=postgresql+asyncpg://mato_system:O-ZGARTIRING-system-paroli@db:5432/mato_savdo
REDIS_URL=redis://redis:6379/0

# --- Kalitlar ---
# Tokenlar va PIN qidiruv xeshi. Yo'qolsa: hamma qayta kiradi, sotuvchilar PIN'i qayta o'rnatiladi
SECRET_KEY=O-ZGARTIRING-openssl-rand-base64-48
# Ko'rinadigan parol/PIN va tasdiqlash ilovasi kaliti shifri. SECRET_KEY dan FARQLI bo'lsin.
# Yo'qolsa: "parolni ko'rish" bo'sh qoladi, platforma egasi zaxira kod bilan kiradi (kirish ishlayveradi)
CREDENTIALS_KEY=O-ZGARTIRING-openssl-rand-base64-48-boshqasi
# Platforma egasiga tasdiqlash ilovasi (2FA) majburiy
PLATFORM_2FA_REQUIRED=true
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# --- Fayllar ---
# Konteyner ichidagi yo'l (media volume). O'zgartirmang.
MEDIA_DIR=/data/media

# --- Telegram ---
# @BotFather → /newbot → token. Bo'sh — Telegram qismi o'chiq (xabarlar faqat tizim ichida)
TELEGRAM_BOT_TOKEN=
# Platforma egasining chat raqami: "zaxira olinmadi", "qoldiq farqi" xabarlari shu yerga.
# Olish: botga /start yuboring, so'ng @userinfobot ga yozib o'z Id ingizni oling
PLATFORM_ALERT_CHAT_ID=

# --- Zaxira (docs/07-ishga-tushirish.md, 5-bo'lim) ---
# age OCHIQ kaliti (age-keygen o'z kompyuteringizda; yopiq kalit serverga YUKLANMAYDI)
BACKUP_AGE_RECIPIENT=age1O-ZGARTIRING
# rclone remote (S3-mos ombor): nom:bucket/papka. Sozlama fayli: deploy/backup/conf/rclone.conf
# Bo'sh — nusxa faqat shu serverda qoladi (talabga zid, vaqtinchalik)
BACKUP_RCLONE_REMOTE=
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
