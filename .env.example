# Nusxa oling: cp .env.example .env

# Portlar — kompyuterda band bo'lsa shu yerda o'zgartiring (pastdagi URL'larni ham moslang)
DB_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=5173

POSTGRES_USER=mato
POSTGRES_PASSWORD=mato_dev_parol
POSTGRES_DB=mato_savdo

# Bazaga ikki xil rol bilan ulanamiz:
#  - DATABASE_URL       — ilova roli (mato_app). Row-Level Security shu rolga ta'sir qiladi;
#                         biznes ichidagi barcha so'rovlar shu orqali. Rolni 1-migratsiya yaratadi.
#  - DATABASE_OWNER_URL — jadvallar egasi (RLS'dan tashqari). Faqat migratsiyalar, kirishdagi
#                         qidiruv (biznes hali noma'lum) va platforma paneli uchun.
DATABASE_URL=postgresql+asyncpg://mato_app:mato_app_dev_parol@localhost:5432/mato_savdo
DATABASE_OWNER_URL=postgresql+asyncpg://mato:mato_dev_parol@localhost:5432/mato_savdo
REDIS_URL=redis://localhost:6379/0

# dev | prod. "prod" da kirish cookie'si faqat HTTPS orqali yuboriladi.
APP_ENV=dev

# Kamida 32 belgi, ishlab chiqarishda albatta o'zgartiring
SECRET_KEY=dev-secret-key-o-zgartiring-32-belgi-yetarli
# Ega xodimlarining, platforma egasi esa egalarning parolini ko'ra oladi — parollar shu kalit bilan
# shifrlab saqlanadi. Serverda albatta alohida uzun tasodifiy qiymat qo'ying (SECRET_KEY dan farqli) va
# zaxirasini saqlang: kalit yo'qolsa, saqlangan parollar ko'rinmay qoladi (kirish ishlayveradi).
CREDENTIALS_KEY=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Yuklangan rasmlar (mato, rang, gul) saqlanadigan papka. Bo'sh bo'lsa — loyiha ildizidagi media/
# MEDIA_DIR=/var/lib/mato-savdo/media

# Telegram boti (ixtiyoriy). @BotFather → /newbot → token. Bo'sh bo'lsa — Telegram qismi o'chiq,
# xabarlar faqat tizim ichida. Token qo'yilgach fon ishchisi ham ishlashi kerak: arq app.worker.WorkerSettings
TELEGRAM_BOT_TOKEN=

APP_TIMEZONE=Asia/Tashkent
CORS_ORIGINS=http://localhost:5173
